  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "PROJECT LOG \u2014 EXPERIMENT #27\r\nDATE: 10.15.1996\r\nSUBJECT: Chameleon
    + monkey + frog genes\r\nDESIGNATION: \"Darkhinders\"\r\n\r\nWe've designated
    them Darkhinders. Nocturnal, dark-skinned creatures with advanced mimicry capabilities
    \u2014 nearly invisible in low light. High endurance and speed, consistent with
    previous primate-gene trials.\r\n\r\nThis is our second attempt at integrating
    primate DNA into a non-mammalian base. Intelligence enhancement remains unsuccessful.
    No signs of tool use, vocal learning, or self-awareness observed.\r\n\r\nUPDATE
    (#27.1) \u2014 Replaced frog gene sequence with armadillo. Mobility decreased.
    Physical resilience increased. Trade-off accepted.\r\n\r\nNote: Still not what
    we're looking for. But they're harder to kill now.\r\n\r\nNEXT STEP: Awaiting
    approval for human-trial integration. Will update accordingly."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: dc36b3fdc14f47ebb36fd484a67e268a, type: 2}
